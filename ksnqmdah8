                CreateTween({UIScaleObj, "Scale", 1.2, 0.1})

                CreateTween({LabelVal, "Rotation", math.random(-1, 1) * 5, 0.15, true})

                CreateTween({UIScaleObj, "Scale", 1, 0.2})

