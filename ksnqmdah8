function redzlib:GetIcon(index)

    if type(index) ~= "string" or index:find("rbxassetid://") or #index == 0 then return index end

    index = string.lower(index):gsub("lucide", ""):gsub("-", "")

    if self.Icons[index] then return self.Icons[index] end

    for Name, Icon in pairs(self.Icons) do

        if Name == index then return Icon end

    end

    return index

end



function redzlib:SetTheme(NewTheme)
    if not VerifyTheme(NewTheme) then return false end

    redzlib.Save.Theme = NewTheme
    SaveJson("Lyra library V1.json", redzlib.Save)
    Theme = redzlib.Themes[NewTheme]
    Connection:FireConnection("ThemeChanging", NewTheme)

    -- Hyperion: toggle accents follow the selected theme.
    for _, visual in ipairs(redzlib.ToggleVisuals) do
        if visual.Slider and visual.Slider.Parent then
            visual.Slider.BackgroundColor3 = visual.Active and Theme["Color Theme"] or visual.OffColor
        end
        if visual.Glow and visual.Glow.Parent then
            visual.Glow.Color = Theme["Color Theme"]
            visual.Glow.Transparency = visual.Active and 0.28 or 0.88
        end
        if visual.Stroke and visual.Stroke.Parent then
            visual.Stroke.Color = Theme["Color Theme"]
        end
    end

    -- Atualiza objetos registrados e limpa referências de componentes destruídos.
    local alive = {}
    for _, entry in ipairs(redzlib.Instances) do
        local obj = entry and entry.Instance
        if obj and obj.Parent then
            table.insert(alive, entry)
            local role = entry.Type
            pcall(function()
                if role == "Gradient" then
                    obj.Color = Theme["Color Hub 1"]
                elseif role == "Frame" then
                    obj.BackgroundColor3 = Theme["Color Hub 2"]
                elseif role == "Stroke" then
                    local prop = GetColor(obj)
                    if prop ~= "" then obj[prop] = Theme["Color Stroke"] end
                elseif role == "Theme" or role == "ScrollBar" then
                    local prop = GetColor(obj)
                    if prop ~= "" then obj[prop] = Theme["Color Theme"] end
                elseif role == "Text" then
                    local prop = GetColor(obj)
                    if prop ~= "" then obj[prop] = Theme["Color Text"] end
                    if obj:IsA("TextBox") then obj.PlaceholderColor3 = Theme["Color Dark Text"] end
                elseif role == "DarkText" then
                    local prop = GetColor(obj)
                    if prop ~= "" then obj[prop] = Theme["Color Dark Text"] end
                end
            end)
        end
    end
    redzlib.Instances = alive
    Connection:FireConnection("ThemeChanged", NewTheme)
    return true
end



-- Personalização dinâmica: mantém a API de temas existente e permite cores próprias.
function redzlib:SetAccentColor(NewColor)
    if typeof(NewColor) ~= "Color3" then return false end
    Theme["Color Theme"] = NewColor
    Theme["Color Stroke"] = NewColor:Lerp(Color3.fromRGB(35, 12, 55), 0.28)
    Theme["Color Element Stroke"] = NewColor:Lerp(Color3.fromRGB(20, 8, 32), 0.42)
    Theme["Color Hub 1"] = ColorSequence.new({
        ColorSequenceKeypoint.new(0, NewColor:Lerp(Color3.fromRGB(12, 5, 22), 0.72)),
        ColorSequenceKeypoint.new(0.5, NewColor:Lerp(Color3.fromRGB(18, 8, 30), 0.42)),
        ColorSequenceKeypoint.new(1, NewColor:Lerp(Color3.fromRGB(12, 5, 22), 0.72))
    })

    for _, entry in ipairs(redzlib.Instances) do
        local obj = entry.Instance
        if obj and obj.Parent then
            if entry.Type == "Gradient" then
                obj.Color = Theme["Color Hub 1"]
            elseif entry.Type == "Frame" then
                obj.BackgroundColor3 = Theme["Color Hub 2"]
            elseif entry.Type == "Stroke" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Stroke"] end
            elseif entry.Type == "Theme" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Theme"] end
            elseif entry.Type == "Text" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Text"] end
            elseif entry.Type == "DarkText" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Dark Text"] end
            elseif entry.Type == "ScrollBar" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Theme"] end
            end
        end
    end
    -- Keep every toggle track and glow in sync with custom accent colors.
    for _, visual in ipairs(redzlib.ToggleVisuals) do
        if visual.Slider and visual.Slider.Parent then
            visual.Slider.BackgroundColor3 = visual.Active and NewColor or visual.OffColor
        end
        if visual.Glow and visual.Glow.Parent then
            visual.Glow.Color = NewColor
            visual.Glow.Transparency = visual.Active and 0.28 or 0.88
        end
        if visual.Stroke and visual.Stroke.Parent then visual.Stroke.Color = NewColor end
    end
    -- V18.6: synchronize the library accent with the dedicated Theme Studio engine.
    if LyraThemeStudio then
        LyraThemeStudio.Accent = NewColor
        LyraThemeStudio:SyncAccent(NewColor, 0.18)
    end
    -- Sync primary window neon and all explicitly accent-linked UI strokes.
    for _, inst in ipairs(MainFrame:GetDescendants()) do
        if inst:IsA("UIStroke") then
            if inst.Name == "LyraLiquidGlassNeonGlow" or inst.Name == "LyraTabNeonGlow" or inst:GetAttribute("LyraAccentSync") == true then
                inst.Color = NewColor
            end
        elseif (inst:IsA("ImageLabel") or inst:IsA("ImageButton")) and inst:GetAttribute("LyraAccentSync") == true then
            inst.ImageColor3 = NewColor
        end
    end
    if MainNeonGlow and MainNeonGlow.Parent then MainNeonGlow.Color = NewColor end
    Connection:FireConnection("ThemeChanged", "Custom")
    return true
end

function redzlib:AddTheme(Name, Palette)
    if type(Name) ~= "string" or Name == "" or type(Palette) ~= "table" then return false end
    local required = {"Color Hub 1", "Color Hub 2", "Color Stroke", "Color Theme", "Color Text", "Color Dark Text", "Color Element", "Color Element Stroke"}
    for _, key in ipairs(required) do
        if Palette[key] == nil then return false end
    end
    redzlib.Themes[Name] = Palette
    return true
end

