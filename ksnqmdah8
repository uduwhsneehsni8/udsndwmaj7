function redzlib:SetMotionPreset(name)
    local preset = self.MotionPresets[name]
    if not preset then return false end
    self.VisualSettings.Motion = name
    self.VisualSettings.MotionDuration = preset.Duration
    self.VisualSettings.MotionStyle = preset.Style
    self.VisualSettings.MotionDirection = preset.Direction
    return true
end


function redzlib:SetVisualProfile(name)
    local profile = self.VisualProfiles[name]
    if not profile then return false end
    for key, value in pairs(profile) do self.VisualSettings[key] = value end
    self.VisualSettings.Profile = name
    return true
end


function redzlib:SetLayoutPreset(name)
    for _, preset in ipairs(self.LayoutPresets) do
        if preset == name then self.VisualSettings.Layout = name; return true end
    end
    return false
end


function redzlib:SetPerformanceMode(mode)
    if mode ~= "Performance" and mode ~= "Balanced" and mode ~= "Visual" then return false end
    self.VisualSettings.Performance = mode
    self.VisualSettings.ReducedMotion = mode == "Performance"
    if mode == "Performance" then
        self.VisualSettings.GlowIntensity = 0
    elseif mode == "Balanced" then
        self.VisualSettings.GlowIntensity = 0.45
    else
        self.VisualSettings.GlowIntensity = 0.85
    end
    return true
end


function redzlib:GetThemeNames()
    local names = {}
    for name in pairs(self.Themes) do table.insert(names, name) end
    table.sort(names)
    return names
end


function redzlib:CreateSnapshot()
    local themeName = self.Save and self.Save.Theme or nil
    local accent = Theme and Theme["Color Theme"] or Color3.fromRGB(160, 55, 245)
    return {
        Version = 16, Theme = themeName,
        Accent = {R = math.floor(accent.R * 255 + 0.5), G = math.floor(accent.G * 255 + 0.5), B = math.floor(accent.B * 255 + 0.5)},
        VisualSettings = table.clone(self.VisualSettings)
    }
end


function redzlib:RestoreSnapshot(snapshot)
    if type(snapshot) ~= "table" then return false end
    if type(snapshot.Theme) == "string" and self.Themes[snapshot.Theme] then self:SetTheme(snapshot.Theme) end
    local accent = snapshot.Accent
    if type(accent) == "table" and tonumber(accent.R) and tonumber(accent.G) and tonumber(accent.B) then
        self:SetAccentColor(Color3.fromRGB(math.clamp(tonumber(accent.R), 0, 255), math.clamp(tonumber(accent.G), 0, 255), math.clamp(tonumber(accent.B), 0, 255)))
    end
    if type(snapshot.VisualSettings) == "table" then
        for key, value in pairs(snapshot.VisualSettings) do
            if self.VisualSettings[key] ~= nil and type(value) == type(self.VisualSettings[key]) then self.VisualSettings[key] = value end
        end
    end
    return true
end


function redzlib:ResetVisualSettings()
