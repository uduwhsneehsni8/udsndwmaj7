local function lyraTSHex(color)
    return string.format("#%02X%02X%02X", math.round(color.R*255), math.round(color.G*255), math.round(color.B*255))
end
local function lyraTSFromHex(text)
    if type(text)~="string" then return nil end
    text=text:gsub("#",""):gsub("%s","")
    if #text~=6 or not text:match("^%x+$") then return nil end
    local r=tonumber(text:sub(1,2),16)/255
    local g=tonumber(text:sub(3,4),16)/255
    local b=tonumber(text:sub(5,6),16)/255
    return Color3.new(r,g,b)
end
function LyraThemeStudio:PushHistory()
    table.insert(self.History,1,{Accent=self.Accent,Hex=lyraTSHex(self.Accent),Time=os.time()})
    while #self.History>30 do table.remove(self.History) end
end
function LyraThemeStudio:SetAccentHex(hex,duration)
    local color=lyraTSFromHex(hex)
    if not color then return false,"HEX inválido. Use #RRGGBB." end
    self:PushHistory()
    return self:SetAccent(color,duration)
end
function LyraThemeStudio:SaveTheme(name)
    name=tostring(name or "Theme"):sub(1,32)
    if name=="" then return false,"Nome inválido" end
    self.SavedThemes[name]={Accent={self.Accent.R,self.Accent.G,self.Accent.B},NeonEnabled=self.NeonEnabled,NeonIntensity=self.NeonIntensity,NeonThickness=self.NeonThickness,BackgroundTransparency=self.BackgroundTransparency}
    return true
end
function LyraThemeStudio:LoadTheme(name)
    local data=self.SavedThemes[name]
    if not data then return false,"Tema não encontrado" end
    if type(data.Accent)=="table" then self:SetAccent(Color3.new(data.Accent[1],data.Accent[2],data.Accent[3])) end
    self:SetNeonEnabled(data.NeonEnabled~=false); self:SetNeonIntensity(data.NeonIntensity); self:SetNeonThickness(data.NeonThickness)
    if data.BackgroundTransparency then self.BackgroundTransparency=math.clamp(data.BackgroundTransparency,0,1) end
    return true
end
function LyraThemeStudio:ListSavedThemes()
    local names={}; for name in pairs(self.SavedThemes) do table.insert(names,name) end; table.sort(names); return names
end
