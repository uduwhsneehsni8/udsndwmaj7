            SliderThumbScale.Parent = SliderIcon
            SliderHolder.MouseEnter:Connect(function()
                TweenService:Create(SliderThumbScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.35}):Play()
                TweenService:Create(SliderGlow, TweenInfo.new(0.16), {Transparency = 0.35, Thickness = 1.6}):Play()
            end)
            SliderHolder.MouseLeave:Connect(function()
