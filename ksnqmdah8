                TweenService:Create(SliderGlow, TweenInfo.new(0.18), {Transparency = 0.68, Thickness = 1.15}):Play()
            end)

            local LabelVal = InsertTheme(Create("TextLabel", SliderHolder, {Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, 0, 0.5), BackgroundTransparency = 1, TextColor3 = Theme["Color Text"], Font = Enum.Font.Gotham, TextSize = 12}), "Text")

            local UIScaleObj = Create("UIScale", LabelVal)

            local BaseMousePos = Create("Frame", SliderBar, {Position = UDim2.new(0, 0, 0.5, 0), Visible = false})

            

            local function UpdateLabel(NewValue)

                local Number = tonumber(NewValue * Increase)

                Number = math.floor(Number * 100) / 100

                Default, LabelVal.Text = Number, tostring(Number)

                Funcs:FireCallback(Callback, Default)

            end

            

            local function SetSliderFlex(direction)
                if LyraSliderFlexEnabled == false or not direction or direction == 0 then return end
                local maxAngle = math.clamp(tonumber(LyraSliderFlexAngle) or 4.5, 1, 10)
                local targetRotation = direction < 0 and -maxAngle or maxAngle
                if SliderFlexTween then pcall(function() SliderFlexTween:Cancel() end) end
                SliderFlexTween = TweenService:Create(SliderBar, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = targetRotation})
                SliderFlexTween:Play()
                TweenService:Create(SliderFlexScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = math.clamp(tonumber(LyraSliderFlexScale) or 1.025, 1, 1.08)}):Play()
                TweenService:Create(SliderThumbScale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.45}):Play()
            end
            local function ResetSliderFlex()
                if SliderFlexTween then pcall(function() SliderFlexTween:Cancel() end) end
                SliderFlexTween = TweenService:Create(SliderBar, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = 0})
                SliderFlexTween:Play()
                TweenService:Create(SliderFlexScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
                TweenService:Create(SliderThumbScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
                SliderLastPointerX = nil
            end
            local function ControlPos()

                local MousePos = Player:GetMouse()
                if SliderLastPointerX then SetSliderFlex(MousePos.X - SliderLastPointerX) end
                SliderLastPointerX = MousePos.X

                local APos = MousePos.X - BaseMousePos.AbsolutePosition.X

                local ConfigureDpiPos = APos / SliderBar.AbsoluteSize.X

                SliderIcon.Position = UDim2.new(math.clamp(ConfigureDpiPos, 0, 1), 0, 0.5, 0)

            end

            

            local function UpdateValues()

                Indicator.Size = UDim2.new(SliderIcon.Position.X.Scale, 0, 1, 0)

                local SliderPos = SliderIcon.Position.X.Scale

                local NewValue = math.floor(((SliderPos * Max) / Max) * (Max - Min) + Min)

                UpdateLabel(NewValue)

            end

            

            SliderHolder.MouseButton1Down:Connect(function()

                CreateTween({SliderIcon, "Transparency", 0, 0.3})

                Container.ScrollingEnabled = false

                while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do

                    task.wait()

                    ControlPos()

                end

                CreateTween({SliderIcon, "Transparency", 0.2, 0.3})
                ResetSliderFlex()

                Container.ScrollingEnabled = true

                SetFlag(Flag, Default)

            end)

            

            LabelVal:GetPropertyChangedSignal("Text"):Connect(function()

