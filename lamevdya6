            Make("Corner",fill,UDim.new(1,0))
            local obj={}
            function obj:Set(v) value=math.clamp(tonumber(v) or 0,0,100); fill.Size=UDim2.new(value/100,0,1,0) end
            function obj:Get() return value end
            function obj:Destroy() holder:Destroy() end
            function obj:Visible(v) holder.Visible=v~=false end
            return obj
        end

        function Tab:AddActivityFeed(Configs)
            Configs=Configs or {}
            local entries=Configs.Items or {}
            local holder=Create("Frame",Container,{Name="LyraActivityFeed",Size=UDim2.new(1,-8,0,math.clamp(#entries*27+8,35,170)),BackgroundColor3=Theme["Color Hub 2"],BackgroundTransparency=0.12,BorderSizePixel=0})
            Make("Corner",holder,UDim.new(0,8))
            local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,2); layout.Parent=holder
            local function add(entry)
                local row=Create("TextLabel",holder,{Size=UDim2.new(1,-12,0,24),BackgroundColor3=Theme["Color Element"],BackgroundTransparency=0.6,Text="  "..tostring(entry.Time or "").."  "..tostring(entry.Text or entry),TextColor3=Theme["Color Text"],Font=Enum.Font.Gotham,TextSize=8,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd})
                Make("Corner",row,UDim.new(0,5))
            end
            for _,entry in ipairs(entries) do add(entry) end
            local obj={}
            function obj:Add(entry) add(entry) end
            function obj:Clear() for _,c in ipairs(holder:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end end
            function obj:Destroy() holder:Destroy() end
            function obj:Visible(v) holder.Visible=v~=false end
            return obj
        end

        -- Omniverse hover configuration API and local window/panel registry.
        redzlib.HoverEngine = redzlib.HoverEngine or {Enabled=true,Intensity=1,MaxTilt=2.2,Style="Lift"}
        function redzlib:SetHoverStyle(style)
            local allowed={Lift=true,Float=true,Magnetic=true,Tilt=true}
            if allowed[style] then self.HoverEngine.Style=style end
            return self.HoverEngine.Style
        end
        function redzlib:GetHoverSettings()
            return {Enabled=self.HoverEngine.Enabled,Intensity=self.HoverEngine.Intensity,MaxTilt=self.HoverEngine.MaxTilt,Style=self.HoverEngine.Style}
        end
        redzlib.WindowManager = redzlib.WindowManager or {Panels={}}
        function redzlib.WindowManager:Register(name,guiObject)
            if typeof(guiObject)=="Instance" and guiObject:IsA("GuiObject") then self.Panels[tostring(name)]=guiObject; return true end
            return false
        end
        function redzlib.WindowManager:Remove(name)
            local panel=self.Panels[tostring(name)]
            if panel then self.Panels[tostring(name)]=nil; return true end
            return false
        end
        function redzlib.WindowManager:SetVisible(name,visible)
            local panel=self.Panels[tostring(name)]
            if panel and panel.Parent then panel.Visible=visible~=false; return true end
            return false
        end
        function redzlib:ExportThemeConfig()
            return {Theme=self.Save.Theme,Accent={R=r,G=g,B=b},Hover=self:GetHoverSettings(),Transparency=self.Save.Transparency,Neon=self.Save.Neon}
        end
        function redzlib:ImportThemeConfig(config)
            if type(config)~="table" then return false end
            if type(config.Theme)=="string" then pcall(function() self:SetTheme(config.Theme) end) end
            if type(config.Accent)=="table" then
                r=math.clamp(tonumber(config.Accent.R) or r,0,255)
                g=math.clamp(tonumber(config.Accent.G) or g,0,255)
                b=math.clamp(tonumber(config.Accent.B) or b,0,255)
                pcall(applyAccent)
            end
            if type(config.Hover)=="table" then
                self.HoverEngine.Enabled=config.Hover.Enabled~=false
                self.HoverEngine.Intensity=math.clamp(tonumber(config.Hover.Intensity) or 1,0,2)
                self.HoverEngine.MaxTilt=math.clamp(tonumber(config.Hover.MaxTilt) or 2.2,0,5)
                self:SetHoverStyle(config.Hover.Style or "Lift")
            end
            return true
        end

        if not ThemeStudioCreated and Configs.ThemeStudio ~= false and TName ~= "Theme Studio" and BuildThemeStudio then
            ThemeStudioCreated = true
            task.defer(BuildThemeStudio)
        end

        return Tab

    end

    

