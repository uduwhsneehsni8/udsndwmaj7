        local function LyraCreateSimpleChart(container, chartName, configs, chartType)
            configs=configs or {}
            local data=configs.Values or configs.Data or {25,45,35,70,55,90}
            local holder=Create("Frame",container,{Name=chartName,Size=UDim2.new(1,-8,0,112),BackgroundColor3=Theme["Color Hub 2"],BackgroundTransparency=0.12,BorderSizePixel=0})
            Make("Corner",holder,UDim.new(0,9))
            local maxValue=1
            for _,v in ipairs(data) do maxValue=math.max(maxValue,tonumber(v) or 0) end
            local gap=4
            for i,v in ipairs(data) do
                local ratio=math.clamp((tonumber(v) or 0)/maxValue,0,1)
                if chartType=="Bar" then
                    local bar=Create("Frame",holder,{Size=UDim2.new(1/#data,-gap,0,math.max(3,ratio*72)),Position=UDim2.new((i-1)/#data, gap/2,1,-12-math.max(3,ratio*72)),BackgroundColor3=Theme["Color Theme"],BorderSizePixel=0})
                    Make("Corner",bar,UDim.new(0,4))
                else
                    local dot=Create("Frame",holder,{Size=UDim2.fromOffset(7,7),Position=UDim2.new((i-1)/math.max(1,#data-1),-3,1,-12-ratio*72),BackgroundColor3=Theme["Color Theme"],BorderSizePixel=0})
                    Make("Corner",dot,UDim.new(1,0))
                end
            end
            local title=Create("TextLabel",holder,{Size=UDim2.new(1,-14,0,17),Position=UDim2.fromOffset(7,4),BackgroundTransparency=1,Text=tostring(configs.Name or chartName),TextColor3=Theme["Color Dark Text"],Font=Enum.Font.GothamBold,TextSize=8,TextXAlignment=Enum.TextXAlignment.Left})
            local obj={}
            function obj:SetValues(v) for _,c in ipairs(holder:GetChildren()) do if c:IsA("Frame") and c~=holder then c:Destroy() end end; data=v or {}; maxValue=1; for _,n in ipairs(data) do maxValue=math.max(maxValue,tonumber(n) or 0) end; for i,n in ipairs(data) do local ratio=math.clamp((tonumber(n) or 0)/maxValue,0,1); if chartType=="Bar" then local h=math.max(3,ratio*72); local bar=Create("Frame",holder,{Size=UDim2.new(1/#data,-gap,0,h),Position=UDim2.new((i-1)/#data,gap/2,1,-12-h),BackgroundColor3=Theme["Color Theme"],BorderSizePixel=0}); Make("Corner",bar,UDim.new(0,4)) else local dot=Create("Frame",holder,{Size=UDim2.fromOffset(7,7),Position=UDim2.new((i-1)/math.max(1,#data-1),-3,1,-12-ratio*72),BackgroundColor3=Theme["Color Theme"],BorderSizePixel=0}); Make("Corner",dot,UDim.new(1,0)) end end end
            function obj:Destroy() holder:Destroy() end
            function obj:Visible(v) holder.Visible=v~=false end
            return obj
        end

