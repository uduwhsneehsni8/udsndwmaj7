-- LYRA INTERACTION FEEDBACK: hover lift + press bounce for interactive surfaces.
local function ApplyLyraHoverLift(target, options)
    if not target or not target:IsA("GuiObject") or target:GetAttribute("LyraHoverLiftBound") then return end
    options = options or {}
    target:SetAttribute("LyraHoverLiftBound", true)
    local scale = target:FindFirstChild("LyraHoverScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Name = "LyraHoverScale"
        scale.Scale = 1
        scale.Parent = target
    end
    local activeTween
    local positionTween
    local tiltTween
    local hovering = false
    local originalPosition = target.Position
    local originalRotation = target.Rotation
    local liftOffset = tonumber(options.LiftOffset) or 4
    local hoverStyle = options.Style or "Lift"
    local tiltEnabled = options.Tilt ~= false or hoverStyle == "Tilt"
    local function animate(value, duration, style)
        if activeTween then activeTween:Cancel() end
        activeTween = TweenService:Create(scale, TweenInfo.new(duration, style or Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=value})
        activeTween:Play()
    end
    local function move(yOffset, duration, style)
        if positionTween then positionTween:Cancel() end
        positionTween = TweenService:Create(target, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(originalPosition.X.Scale, originalPosition.X.Offset, originalPosition.Y.Scale, originalPosition.Y.Offset + yOffset)
        })
        positionTween:Play()
    end
    local function tilt(value, duration)
        if not tiltEnabled then return end
        if tiltTween then tiltTween:Cancel() end
        tiltTween = TweenService:Create(target, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation=value})
        tiltTween:Play()
    end
    target.MouseEnter:Connect(function()
        hovering = true
        local scaleValue = hoverStyle == "Float" and 1.018 or (options.HoverScale or 1.03)
        animate(scaleValue, 0.2, Enum.EasingStyle.Back)
        move(hoverStyle == "Float" and -liftOffset*0.6 or -liftOffset, 0.2, Enum.EasingStyle.Quint)
    end)
    if tiltEnabled then
        target.MouseMoved:Connect(function(x, y)
            if not hovering then return end
            local center = target.AbsolutePosition.X + target.AbsoluteSize.X/2
            local ratio = math.clamp((x-center)/math.max(1,target.AbsoluteSize.X/2),-1,1)
            tilt(ratio * (tonumber(options.MaxTilt) or 2.2), 0.12)
        end)
    end
    target.MouseLeave:Connect(function()
        hovering = false
        animate(1, 0.22, Enum.EasingStyle.Elastic)
        move(0, 0.24, Enum.EasingStyle.Elastic)
        tilt(originalRotation,0.18)
    end)
    target.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            animate(options.PressScale or 0.965, 0.075, Enum.EasingStyle.Quad)
            move(-liftOffset - 1, 0.075, Enum.EasingStyle.Quad)
        end
    end)
    target.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            animate(hovering and (options.HoverScale or 1.025) or 1, 0.24, Enum.EasingStyle.Elastic)
            move(hovering and -liftOffset or 0, 0.24, Enum.EasingStyle.Elastic)
        end
    end)
end

local function CreateTween(Configs)

    local Instance = Configs[1] or Configs.Instance

    local Prop = Configs[2] or Configs.Prop

    local NewVal = Configs[3] or Configs.NewVal

    local Time = Configs[4] or Configs.Time or 0.5

    local TweenWait = Configs[5] or Configs.wait or false

    local Tween = TweenService:Create(Instance, TweenInfo.new(Time, Enum.EasingStyle.Quint), {[Prop] = NewVal})

    Tween:Play()

    if TweenWait then Tween.Completed:Wait() end

    return Tween

end



-- Lyra UI FX: helpers reutilizaveis e leves para componentes.
local function AddSoftStroke(target, color, thickness, transparency, name)
    local stroke = Instance.new("UIStroke")
    stroke.Name = name or "LyraSoftStroke"
    stroke.Color = color or Color3.fromRGB(155, 65, 245)
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0.7
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = target
    return stroke
end

local function AddPressScale(target, pressedScale)
    local scale = target:FindFirstChild("LyraPressScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Name = "LyraPressScale"
        scale.Scale = 1
        scale.Parent = target
    end
    local down = pressedScale or 0.975
    target.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(scale, TweenInfo.new(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = down}):Play()
        end
    end)
    target.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end
    end)
    return scale
end

local function MakeDrag(Instance)

    task.spawn(function()

        SetProps(Instance, {Active = true, AutoButtonColor = false})

        local DragStart, StartPos, InputOn

        local function Update(Input)

            local delta = Input.Position - DragStart

            local Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X / UIScale, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y / UIScale)

            CreateTween({Instance, "Position", Position, 0.35})

        end

        Instance.MouseButton1Down:Connect(function() InputOn = true end)

        Instance.InputBegan:Connect(function(Input)

            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then

                StartPos = Instance.Position

                DragStart = Input.Position

                while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do

                    RunService.Heartbeat:Wait()

                    if InputOn then Update(Input) end

                end

                InputOn = false

            end

        end)

    end)

    return Instance

end



local function ConnectSave(Instance, func)

    Instance.InputBegan:Connect(function(Input)

        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then

            while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do task.wait() end

        end

        func()

    end)

end



