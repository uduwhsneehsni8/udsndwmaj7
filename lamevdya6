    MainSweepFade.Parent = MainBorderSweep

    -- Relógio próprio: evita depender da variável local criada depois na rotina das abas.
    local MainBorderSyncStart = os.clock()

    local function MainPerimeter(w,h)
        local inset,radius=1.5,16
        local l,r,t,b=inset,w-inset,inset,h-inset
        radius=math.min(radius,(h-2*inset)/2,(w-2*inset)/2)
        local segs,total={},0
        local function line(x1,y1,x2,y2)
            local len=math.sqrt((x2-x1)^2+(y2-y1)^2)
            if len>0 then segs[#segs+1]={kind="line",x1=x1,y1=y1,x2=x2,y2=y2,len=len};total=total+len end
        end
        local function arc(cx,cy,a1,a2)
            local len=radius*math.abs(a2-a1)
            segs[#segs+1]={kind="arc",cx=cx,cy=cy,r=radius,a1=a1,a2=a2,len=len};total=total+len
        end
        line(l+radius,t,r-radius,t);arc(r-radius,t+radius,-math.pi/2,0)
        line(r,t+radius,r,b-radius);arc(r-radius,b-radius,0,math.pi/2)
        line(r-radius,b,l+radius,b);arc(l+radius,b-radius,math.pi/2,math.pi)
        line(l,b-radius,l,t+radius);arc(l+radius,t+radius,math.pi,math.pi*1.5)
        return segs,total
    end
    local function MainPoint(segs,total,distance)
        distance=distance%total
        local walked=0
        for _,seg in ipairs(segs) do
            if distance<=walked+seg.len then
                local f=math.clamp((distance-walked)/seg.len,0,1)
                if seg.kind=="line" then return seg.x1+(seg.x2-seg.x1)*f,seg.y1+(seg.y2-seg.y1)*f end
                local a=seg.a1+(seg.a2-seg.a1)*f
                return seg.cx+math.cos(a)*seg.r,seg.cy+math.sin(a)*seg.r
            end
            walked=walked+seg.len
        end
        return 0,0
    end
    task.spawn(function()
        while MainFrame and MainFrame.Parent and MainBorderSweep and MainBorderSweep.Parent do
            local scale=math.max(0.01,UIScale)
            local size=MainFrame.AbsoluteSize
            local w,h=size.X/scale,size.Y/scale
            if w>40 and h>40 then
                local segs,total=MainPerimeter(w,h)
                if total>0 then
                    local d=((os.clock()-MainBorderSyncStart)*(total/LyraShineInterval))%total
                    local x,y=MainPoint(segs,total,d)
                    local bx,by=MainPoint(segs,total,d-2.5)
                    local ax,ay=MainPoint(segs,total,d+2.5)
                    MainBorderSweep.Position=UDim2.fromOffset(x,y)
