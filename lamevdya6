        function Tab:AddRatingBar(Configs)
            Configs=Configs or {}
            local value=math.clamp(tonumber(Configs.Value) or 0,0,100)
            local holder=Create("Frame",Container,{Name="LyraRatingBar",Size=UDim2.new(1,-8,0,38),BackgroundColor3=Theme["Color Hub 2"],BackgroundTransparency=0.12,BorderSizePixel=0})
            Make("Corner",holder,UDim.new(0,8))
