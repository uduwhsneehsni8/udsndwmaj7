function redzlib:GetIcon(index)

    if type(index) ~= "string" or index:find("rbxassetid://") or #index == 0 then return index end

    index = string.lower(index):gsub("lucide", ""):gsub("-", "")

    if self.Icons[index] then return self.Icons[index] end

    for Name, Icon in pairs(self.Icons) do

        if Name == index then return Icon end

    end

    return index

end



function redzlib:SetTheme(NewTheme)

    if not VerifyTheme(NewTheme) then return end

    redzlib.Save.Theme = NewTheme

    SaveJson("Lyra library V1.json", redzlib.Save)

    Theme = redzlib.Themes[NewTheme]

    Connection:FireConnection("ThemeChanged", NewTheme)

    for _, Val in pairs(redzlib.Instances) do

        if Val.Type == "Gradient" then Val.Instance.Color = Theme["Color Hub 1"]

        elseif Val.Type == "Frame" then Val.Instance.BackgroundColor3 = Theme["Color Hub 2"]

        elseif Val.Type == "Stroke" then Val.Instance[GetColor(Val.Instance)] = Theme["Color Stroke"]

        elseif Val.Type == "Theme" then Val.Instance[GetColor(Val.Instance)] = Theme["Color Theme"]

        elseif Val.Type == "Text" then Val.Instance[GetColor(Val.Instance)] = Theme["Color Text"]

        elseif Val.Type == "DarkText" then Val.Instance[GetColor(Val.Instance)] = Theme["Color Dark Text"]

        elseif Val.Type == "ScrollBar" then Val.Instance[GetColor(Val.Instance)] = Theme["Color Theme"]

        end

    end

end



-- Personalização dinâmica: mantém a API de temas existente e permite cores próprias.
function redzlib:SetAccentColor(NewColor)
    if typeof(NewColor) ~= "Color3" then return false end
    Theme["Color Theme"] = NewColor
    Theme["Color Stroke"] = NewColor:Lerp(Color3.fromRGB(35, 12, 55), 0.28)
    Theme["Color Element Stroke"] = NewColor:Lerp(Color3.fromRGB(20, 8, 32), 0.42)
    Theme["Color Hub 1"] = ColorSequence.new({
        ColorSequenceKeypoint.new(0, NewColor:Lerp(Color3.fromRGB(12, 5, 22), 0.72)),
        ColorSequenceKeypoint.new(0.5, NewColor:Lerp(Color3.fromRGB(18, 8, 30), 0.42)),
        ColorSequenceKeypoint.new(1, NewColor:Lerp(Color3.fromRGB(12, 5, 22), 0.72))
    })

    for _, entry in ipairs(redzlib.Instances) do
        local obj = entry.Instance
        if obj and obj.Parent then
            if entry.Type == "Gradient" then
                obj.Color = Theme["Color Hub 1"]
            elseif entry.Type == "Frame" then
                obj.BackgroundColor3 = Theme["Color Hub 2"]
            elseif entry.Type == "Stroke" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Stroke"] end
            elseif entry.Type == "Theme" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Theme"] end
            elseif entry.Type == "Text" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Text"] end
            elseif entry.Type == "DarkText" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Dark Text"] end
            elseif entry.Type == "ScrollBar" then
                local prop = GetColor(obj)
                if prop ~= "" then obj[prop] = Theme["Color Theme"] end
            end
        end
    end
    Connection:FireConnection("ThemeChanged", "Custom")
    return true
end

function redzlib:AddTheme(Name, Palette)
    if type(Name) ~= "string" or Name == "" or type(Palette) ~= "table" then return false end
    local required = {"Color Hub 1", "Color Hub 2", "Color Stroke", "Color Theme", "Color Text", "Color Dark Text", "Color Element", "Color Element Stroke"}
    for _, key in ipairs(required) do
        if Palette[key] == nil then return false end
    end
    redzlib.Themes[Name] = Palette
    return true
end

